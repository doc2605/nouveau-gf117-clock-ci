From: Nouveau GF117 contributors
Subject: [PATCH] nouveau: fail closed on unknown GF117 voltage command

Do not enable unvalidated GF117 PWM voltage writes. Fail the core-only
preflight when the current voltage command cannot be read. PWM readback
is not an independent measurement of rail voltage.

--- a/drivers/gpu/drm/nouveau/nvkm/subdev/volt/base.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/volt/base.c
@@ -164,7 +164,6 @@
 {
 	u8 ids[3];
 	int target, cap, i;
-	bool current_known = true;
 
 	if (!current_uv || !limit_uv)
 		return -EINVAL;
@@ -173,14 +172,9 @@
 	if (!volt)
 		return -ENODEV;
 	*current_uv = nvkm_volt_get(volt);
-	if (*current_uv <= 0) {
-		/* GF117's VBIOS PWM output can boot disabled. Its only safe
-		 * initialization is to write the bounded VBIOS target, then prove
-		 * it by readback before touching the core clock. */
-		if (*current_uv != -ENODEV || !volt->func->volt_set)
-			return *current_uv ? *current_uv : -ERANGE;
-		current_known = false;
-	}
+	if (*current_uv <= 0)
+		return *current_uv ? *current_uv : -ERANGE;
+
 	target = nvkm_volt_map(volt, id, temp);
 	if (target <= 0)
 		return target ? target : -ERANGE;
@@ -200,9 +194,9 @@
 		}
 	}
 	*limit_uv = cap;
-	if (target > cap || (current_known && *current_uv > cap))
+	if (target > cap || *current_uv > cap)
 		return -ERANGE;
-	if (current_known && *current_uv >= target)
+	if (*current_uv >= target)
 		return target;
 	/* Check the voltage this backend can actually produce before changing it. */
 	if (volt->func->volt_roundup) {
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/volt/gf117.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/volt/gf117.c
@@ -75,82 +75,6 @@
 }
 
 static int
-gf117_volt_pwm_calc(struct nvkm_volt *base, u32 uv, u32 *divs_out,
-		    u32 *duty_out)
-{
-	struct gf117_volt *volt = container_of(base, struct gf117_volt, base);
-	struct nvkm_device *device = base->subdev.device;
-	u64 max_uv, duty, effective_uv;
-	u32 divs;
-	int clock;
-
-	if (!device->therm || !volt->bios.pwm_freq || !volt->bios.pwm_range)
-		return -ENODEV;
-	max_uv = (u64)volt->bios.base + volt->bios.pwm_range;
-	if (max_uv > INT_MAX || uv < base->min_uv || uv > base->max_uv ||
-	    uv < volt->bios.base || uv > max_uv)
-		return -ERANGE;
-
-	clock = nvkm_therm_pwm_clock(device->therm, volt->pwm_line);
-	if (clock <= 0)
-		return -ENODEV;
-	/* Match the nearest representable period; the readback accepts only the
-	 * adjacent integer periods around the VBIOS frequency. */
-	divs = DIV_ROUND_CLOSEST((u32)clock, volt->bios.pwm_freq);
-	if (!divs || divs > 0x1fff)
-		return -ERANGE;
-	duty = div_u64((u64)(uv - volt->bios.base) * divs +
-		       volt->bios.pwm_range - 1, volt->bios.pwm_range);
-	if (duty > divs)
-		return -ERANGE;
-	effective_uv = volt->bios.base +
-		div_u64((u64)volt->bios.pwm_range * duty, divs);
-	if (effective_uv > base->max_uv || effective_uv > INT_MAX)
-		return -ERANGE;
-	*divs_out = divs;
-	*duty_out = duty;
-	return effective_uv;
-}
-
-static int
-gf117_volt_pwm_roundup(struct nvkm_volt *base, u32 uv)
-{
-	u32 divs, duty;
-	int ret = gf117_volt_pwm_calc(base, uv, &divs, &duty);
-
-	return ret;
-}
-
-static int
-gf117_volt_pwm_set(struct nvkm_volt *base, u32 uv)
-{
-	struct gf117_volt *volt = container_of(base, struct gf117_volt, base);
-	struct nvkm_device *device = base->subdev.device;
-	u32 divs, duty;
-	int ret, readback, effective_uv;
-
-	effective_uv = gf117_volt_pwm_calc(base, uv, &divs, &duty);
-	if (effective_uv <= 0)
-		return effective_uv ? effective_uv : -ERANGE;
-
-	ret = nvkm_therm_pwm_set(device->therm, volt->pwm_line, divs, duty);
-	if (ret)
-		return ret;
-	ret = nvkm_therm_pwm_ctrl(device->therm, volt->pwm_line, true);
-	if (ret)
-		return ret;
-
-	/* Confirm the programmed command is active and does not undershoot the
-	 * requested setpoint before the clock transaction proceeds. */
-	readback = gf117_volt_pwm_get(base);
-	if (readback < 0)
-		return readback;
-	if (readback < effective_uv || readback > base->max_uv)
-		return -ERANGE;
-	return 0;
-}
-
-static int
 gf117_volt_speedo_read(struct nvkm_volt *volt)
 {
 	struct nvkm_device *device = volt->subdev.device;
@@ -172,8 +96,6 @@
 static const struct nvkm_volt_func gf117_volt_pwm = {
 	.oneinit = gf100_volt_oneinit,
 	.volt_get = gf117_volt_pwm_get,
-	.volt_set = gf117_volt_pwm_set,
-	.volt_roundup = gf117_volt_pwm_roundup,
 	.speedo_read = gf117_volt_speedo_read,
 };
 
