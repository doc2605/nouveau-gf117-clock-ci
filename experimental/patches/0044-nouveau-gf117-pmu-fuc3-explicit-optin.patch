+/* SPDX-License-Identifier: MIT */
+/*
+ * Experimental GF117 PMU binding.  This deliberately reuses the GF100 FUC3
+ * image only behind an explicit NVKM option.  No GF117 Falcon boot or firmware
+ * compatibility has been validated; keep the default path unregistered.
+ */
+#include "priv.h"
+
+#include <core/option.h>
+
+int gf100_pmu_new(struct nvkm_device *, enum nvkm_subdev_type, int,
+		  struct nvkm_pmu **);
+
+int
+gf117_pmu_new(struct nvkm_device *device, enum nvkm_subdev_type type, int inst,
+	      struct nvkm_pmu **ppmu)
+{
+	if (!ppmu)
+		return -EINVAL;
+	*ppmu = NULL;
+
+	/* The GF117 dispatch entry is present for this opt-in gate only. */
+	if (!device || device->chipset != 0xd7 ||
+	    !nvkm_boolopt(device->cfgopt, "NvGf117Pmu", false))
+		return -ENODEV;
+
+	return gf100_pmu_new(device, type, inst, ppmu);
+}
