From: Nouveau GF117 contributors
Subject: [PATCH] nouveau: add opt-in Rust GF117 command guard

Experimental scalar validation only; no hardware behavior is validated.

--- a/drivers/gpu/drm/nouveau/Kconfig
+++ b/drivers/gpu/drm/nouveau/Kconfig
@@ -31,6 +31,15 @@
 	select PM_DEVFREQ if ARCH_TEGRA
 	help
 	  Choose this option for open-source NVIDIA support.
+
+config DRM_NOUVEAU_GF117_RUST_GUARD
+	bool "Experimental Rust GF117 voltage-command guard"
+	depends on DRM_NOUVEAU && RUST
+	default n
+	help
+	  Use a Rust scalar guard in the opt-in GF117 core-only clock path.
+	  This does not measure physical voltage or establish safe reclocking.
+	  This option is experimental and not validated on hardware.
 
 config NOUVEAU_PLATFORM_DRIVER
 	bool "Nouveau (NVIDIA) SoC GPUs"
--- a/drivers/gpu/drm/nouveau/Kbuild
+++ b/drivers/gpu/drm/nouveau/Kbuild
@@ -14,6 +14,7 @@
 #- code also used by various userspace tools/tests
 include $(src)/nvkm/Kbuild
 nouveau-y += $(nvkm-y)
+nouveau-$(CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD) += nvkm/subdev/clk/gf117_rust_guard.o
 
 # DRM - general
 ifdef CONFIG_X86
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/clk/base.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/base.c
@@ -35,6 +35,11 @@
 
 #include <core/option.h>
 
+#ifdef CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD
+/* Scalar-only ABI: no pointers, allocation or hardware access. */
+extern int gf117_rust_validate_command(int current_uv, int required_uv, int ceiling_uv);
+#endif
+
 /* Explicit experimental mode: preserve memory's boot clock. */
 static bool
 nvkm_clk_fermi_core_only(struct nvkm_clk *clk)
@@ -214,8 +219,13 @@
 
 	if (core_only) {
 		current_uv = nvkm_volt_get(volt);
+#ifdef CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD
+		if (gf117_rust_validate_command(current_uv, target_uv, limit_uv))
+			return -ERANGE;
+#else
 		if (current_uv < target_uv || current_uv > limit_uv)
 			return -ERANGE;
+#endif
 	}
 
 	ret = clk->func->calc(clk, cstate);
--- /dev/null
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf117_rust_guard.rs
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MIT
+//! Pure validation prototype. Values are commands in microvolts, not measurements.
+#![cfg_attr(not(CONFIG_RUST), no_std)]
+
+/// Validate an already observed voltage command before a hypothetical transition.
+/// Returns 0 for an acceptable command, -1 for unknown, -2 for invalid bounds,
+/// and -3 when the current command is outside the permitted interval.
+/// This function performs no I/O, allocations, pointer access, or voltage changes.
+#[no_mangle]
+pub extern "C" fn gf117_rust_validate_command(current_uv: i32, required_uv: i32, ceiling_uv: i32) -> i32 {
+    if current_uv <= 0 {
+        return -1;
+    }
+    if required_uv <= 0 || ceiling_uv <= 0 || required_uv > ceiling_uv {
+        return -2;
+    }
+    if current_uv < required_uv || current_uv > ceiling_uv {
+        return -3;
+    }
+    0
+}
