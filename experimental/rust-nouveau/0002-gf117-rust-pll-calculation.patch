From: Nouveau GF117 contributors
Subject: [PATCH] nouveau: use Rust PLL candidates for GF117

Use pure scalar Rust PLL arithmetic for GF117 when the opt-in Kconfig
setting is enabled. Other chipsets and builds without the option retain
the existing C calculation. This path adds no MMIO or register writes.

diff --git a/drivers/gpu/drm/nouveau/Kbuild b/drivers/gpu/drm/nouveau/Kbuild
index 7ec7726..ae46409 100644
--- a/drivers/gpu/drm/nouveau/Kbuild
+++ b/drivers/gpu/drm/nouveau/Kbuild
@@ -15,6 +15,7 @@ nouveau-y := $(nvif-y)
 include $(src)/nvkm/Kbuild
 nouveau-y += $(nvkm-y)
 nouveau-$(CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD) += nvkm/subdev/clk/gf117_rust_guard.o
+nouveau-$(CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD) += nvkm/subdev/clk/gf117_pll.o
 
 # DRM - general
 ifdef CONFIG_X86
diff --git a/drivers/gpu/drm/nouveau/Kconfig b/drivers/gpu/drm/nouveau/Kconfig
index 5e3e154..08462a3 100644
--- a/drivers/gpu/drm/nouveau/Kconfig
+++ b/drivers/gpu/drm/nouveau/Kconfig
@@ -33,7 +33,7 @@ config DRM_NOUVEAU
 	  Choose this option for open-source NVIDIA support.
 
 config DRM_NOUVEAU_GF117_RUST_GUARD
-	bool "Experimental Rust GF117 voltage-plan diagnostic"
+	bool "Experimental Rust GF117 diagnostics and PLL calculation"
 	depends on DRM_NOUVEAU && RUST
 	default n
 	help
@@ -40,3 +40,3 @@ config DRM_NOUVEAU_GF117_RUST_GUARD
-	  Validate VBIOS voltage-plan values from Nouveau's read-only pstate_plan
-	  debugfs diagnostic. This does not measure physical voltage or authorize
-	  clock changes. This option is experimental and not hardware-validated.
+	  Enable Rust validation for read-only diagnostics and use Rust to calculate
+	  GF117 PLL candidates. Other chipsets use the existing C calculation. Rust
+	  performs no MMIO; this option is experimental and not hardware-validated.
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf100.c b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf100.c
index 163c1b2..8f8d90a 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf100.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf100.c
@@ -246,6 +246,15 @@ calc_src(struct gf100_clk *clk, int idx, u32 freq, u32 *dsrc, u32 *ddiv)
 	return sclk;
 }
 
+#ifdef CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD
+struct gf117_pll_result { int ret, n, f_n, m, p; };
+extern struct gf117_pll_result
+gf117_rust_gt215_pll_calc(u32 refclk, u32 max_freq, u32 min_inputfreq,
+			  u32 max_inputfreq, u32 min_m, u32 max_m,
+			  u32 min_n, u32 max_n, u32 min_p, u32 max_p,
+			  u32 freq, u32 fractional);
+#endif
+
 static u32
 calc_pll(struct gf100_clk *clk, int idx, u32 freq, u32 *coef)
 {
@@ -270,3 +279,20 @@ calc_pll(struct gf100_clk *clk, int idx, u32 freq, u32 *coef)
-	ret = gt215_pll_calc(subdev, &limits, freq, &N, NULL, &M, &P);
-	if (ret <= 0)
-		return 0;
+#ifdef CONFIG_DRM_NOUVEAU_GF117_RUST_GUARD
+	if (subdev->device->chipset == 0xd7) {
+		struct gf117_pll_result rust = gf117_rust_gt215_pll_calc(
+			limits.refclk, limits.vco1.max_freq,
+			limits.vco1.min_inputfreq, limits.vco1.max_inputfreq,
+			limits.vco1.min_m, limits.vco1.max_m,
+			limits.vco1.min_n, limits.vco1.max_n,
+			limits.min_p, limits.max_p, freq, 0);
+		ret = rust.ret;
+		N = rust.n;
+		M = rust.m;
+		P = rust.p;
+	} else {
+		ret = gt215_pll_calc(subdev, &limits, freq, &N, NULL, &M, &P);
+	}
+#else
+	ret = gt215_pll_calc(subdev, &limits, freq, &N, NULL, &M, &P);
+#endif
+	if (ret <= 0)
+		return 0;
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf117_pll.rs b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf117_pll.rs
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf117_pll.rs
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: MIT
+//! Scalar implementation used for GF117's GT215-style PLL candidates.
+//!
+//! Inputs come from the C-owned VBIOS PLL limits. The function does no MMIO,
+//! allocation, pointer access, logging, or register programming. Results are
+//! meaningful only when `ret > 0`; error returns leave coefficient fields at
+//! zero. When the opt-in GF117 Rust setting is enabled, this calculates the
+//! GF117 candidate; C remains in use for other chipsets and when disabled.
+#![cfg_attr(not(CONFIG_RUST), no_std)]
+
+/// Fixed-layout result shared with Nouveau's C PLL planner.
+#[repr(C)]
+pub struct Gf117PllResult {
+    /// Achieved output frequency, or a negative errno on failure.
+    pub ret: i32,
+    /// Integer feedback divider (N) selected by the PLL solver.
+    pub n: i32,
+    /// Fractional feedback field; unused by the current GF117 C caller.
+    pub f_n: i32,
+    /// Reference input divider (M) selected by the PLL solver.
+    pub m: i32,
+    /// Output post-divider (P) selected by the PLL solver.
+    pub p: i32,
+}
+
+const EINVAL: i32 = -22;
+const ERANGE: i32 = -34;
+const INT_MAX: u64 = i32::MAX as u64;
+
+fn failure(ret: i32) -> Gf117PllResult {
+    Gf117PllResult { ret, n: 0, f_n: 0, m: 0, p: 0 }
+}
+
+/// Calculate a GT215-style PLL candidate from scalar VBIOS bounds.
+///
+/// `fractional != 0` selects Nouveau's optional fractional-N path. Return
+/// values and successful coefficient fields match the patched C solver.
+#[no_mangle]
+pub extern "C" fn gf117_rust_gt215_pll_calc(
+    refclk: u32,
+    max_freq: u32,
+    min_inputfreq: u32,
+    max_inputfreq: u32,
+    min_m: u32,
+    max_m: u32,
+    min_n: u32,
+    max_n: u32,
+    min_p: u32,
+    max_p: u32,
+    freq: u32,
+    fractional: u32,
+) -> Gf117PllResult {
+    if freq == 0
+        || refclk == 0
+        || max_freq == 0
+        || min_inputfreq == 0
+        || max_inputfreq == 0
+        || min_m == 0
+        || min_m > max_m
+        || min_n == 0
+        || min_n > max_n
+        || min_p == 0
+        || min_p > max_p
+        || min_inputfreq > max_inputfreq
+        || max_m > u8::MAX as u32
+        || max_n > u8::MAX as u32
+        || max_p > u8::MAX as u32
+    {
+        return failure(EINVAL);
+    }
+    if freq as u64 > INT_MAX {
+        return failure(ERANGE);
+    }
+
+    let Some(quotient) = max_freq.checked_div(freq) else {
+        return failure(ERANGE);
+    };
+    // C assigns this u32 quotient to signed int before clamping. Linux uses
+    // two's-complement signed integers; mirror that conversion for parity.
+    let mut p = quotient as i32;
+    if p > max_p as i32 {
+        p = max_p as i32;
+    }
+    if p < min_p as i32 {
+        p = min_p as i32;
+    }
+    if p == 0 {
+        return failure(ERANGE);
+    }
+
+    let Some(max_inputfreq_minus_one) = (max_inputfreq as u64).checked_sub(1) else {
+        return failure(ERANGE);
+    };
+    let Some(low_m_numerator) = (refclk as u64).checked_add(max_inputfreq_minus_one) else {
+        return failure(ERANGE);
+    };
+    let Some(low_m_quotient) = low_m_numerator.checked_div(max_inputfreq as u64) else {
+        return failure(ERANGE);
+    };
+    if low_m_quotient > INT_MAX {
+        return failure(ERANGE);
+    }
+    let low_m = (low_m_quotient as u32).max(min_m);
+    let Some(high_m_quotient) = refclk.checked_div(min_inputfreq) else {
+        return failure(ERANGE);
+    };
+    if high_m_quotient as u64 > INT_MAX {
+        return failure(ERANGE);
+    }
+    let high_m = high_m_quotient.min(max_m);
+    if low_m > high_m {
+        return failure(ERANGE);
+    }
+
+    let mut best_error = u64::MAX;
+    let mut best_n = 0i32;
+    let mut best_m = 0i32;
+
+    for m in low_m..=high_m {
+        let Some(numerator) = (freq as u64)
+            .checked_mul(p as u64)
+            .and_then(|value| value.checked_mul(m as u64))
+        else {
+            return failure(ERANGE);
+        };
+        let Some(quotient) = numerator.checked_div(refclk as u64) else {
+            return failure(ERANGE);
+        };
+        let Some(remainder) = numerator.checked_rem(refclk as u64) else {
+            return failure(ERANGE);
+        };
+        if quotient > INT_MAX {
+            return failure(ERANGE);
+        }
+        let mut n = quotient as i32;
+        let mut f_n = 0i32;
+
+        if fractional == 0 {
+            if remainder >= (refclk / 2) as u64 {
+                if n == i32::MAX {
+                    return failure(ERANGE);
+                }
+                let Some(next_n) = n.checked_add(1) else {
+                    return failure(ERANGE);
+                };
+                n = next_n;
+            }
+        } else {
+            if remainder < (refclk / 2) as u64 {
+                let Some(previous_n) = n.checked_sub(1) else {
+                    return failure(ERANGE);
+                };
+                n = previous_n;
+            }
+            let Some(n_refclk) = (n as i64).checked_mul(refclk as i64) else {
+                return failure(ERANGE);
+            };
+            let Some(fractional) = (numerator as i64).checked_sub(n_refclk) else {
+                return failure(ERANGE);
+            };
+            if fractional < i32::MIN as i64 || fractional > i32::MAX as i64 {
+                return failure(ERANGE);
+            }
+            f_n = fractional as i32;
+        }
+
+        if n < min_n as i32 {
+            continue;
+        }
+        if n > max_n as i32 {
+            break;
+        }
+
+        let Some(refclk_n) = (refclk as u64).checked_mul(n as u64) else {
+            return failure(ERANGE);
+        };
+        let Some(actual) = refclk_n
+            .checked_div(m as u64)
+            .and_then(|actual| actual.checked_div(p as u64))
+        else {
+            return failure(ERANGE);
+        };
+        let error = if actual > freq as u64 {
+            actual - freq as u64
+        } else {
+            freq as u64 - actual
+        };
+        if error < best_error {
+            best_error = error;
+            best_n = n;
+            best_m = m as i32;
+        }
+
+        if fractional != 0 {
+            // f_n is nonnegative on this branch, matching C's signed shift.
+            let Some(scaled) = (f_n as i64)
+                .checked_mul(8192)
+                .and_then(|value| value.checked_add(refclk as i64 / 2))
+            else {
+                return failure(ERANGE);
+            };
+            let Some(scaled_fraction) = scaled
+                .checked_div(refclk as i64)
+                .and_then(|value| value.checked_sub(4096))
+                .map(|value| value & 0xffff)
+            else {
+                return failure(ERANGE);
+            };
+            return Gf117PllResult {
+                ret: freq as i32,
+                n,
+                f_n: scaled_fraction as i32,
+                m: m as i32,
+                p,
+            };
+        }
+    }
+
+    if best_error == u64::MAX {
+        return failure(EINVAL);
+    }
+    if best_m == 0 || p == 0 {
+        return failure(ERANGE);
+    }
+    let Some(refclk_n) = (refclk as u64).checked_mul(best_n as u64) else {
+        return failure(ERANGE);
+    };
+    let Some(actual) = refclk_n
+        .checked_div(best_m as u64)
+        .and_then(|actual| actual.checked_div(p as u64))
+    else {
+        return failure(ERANGE);
+    };
+    if actual > INT_MAX {
+        return failure(ERANGE);
+    }
+    Gf117PllResult {
+        ret: actual as i32,
+        n: best_n,
+        f_n: 0,
+        m: best_m,
+        p,
+    }
+}
