+/* The VBIOS interpreter can also reach the legacy CRTC index/data pair
+ * through direct MMIO opcodes, bypassing the VGA port helpers. */
+static u32
+gf100_devinit_mmio(struct nvkm_devinit *init, u32 addr)
+{
+	if (init->subdev.device->chipset == 0xd7 &&
+	    (addr & ~3U) == 0x6013d4) {
+		nvkm_warn(&init->subdev,
+			  "GF117 blocked VBIOS CRTC MMIO access: addr=%06x\n", addr);
+		return ~0U; /* interpreter sentinel: skip access, not register zero */
+	}
+	return addr;
+}
