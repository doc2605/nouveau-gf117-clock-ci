+/* Validate the requested voltage and regulator cap before any setter can
+ * modify the regulator. Unknown current voltage remains a hard failure. */
+int
+nvkm_volt_preflight(struct nvkm_volt *volt, u8 id, u8 temp,
+		    int *current_uv, int *limit_uv)
+{
+	u8 ids[3];
+	int target, cap, i;
+	bool current_known = true;
+
+	if (!current_uv || !limit_uv)
+		return -EINVAL;
+	*current_uv = -ENODEV;
+	*limit_uv = 0;
+	if (!volt)
+		return -ENODEV;
+	*current_uv = nvkm_volt_get(volt);
+	if (*current_uv <= 0) {
+		/* GF117's VBIOS PWM output can boot disabled. Its only safe
+		 * initialization is to write the bounded VBIOS target, then prove
+		 * it by readback before touching the core clock. */
+		if (*current_uv != -ENODEV || !volt->func->volt_set)
+			return *current_uv ? *current_uv : -ERANGE;
+		current_known = false;
+	}
+	target = nvkm_volt_map(volt, id, temp);
+	if (target <= 0)
+		return target ? target : -ERANGE;
+	if (!volt->max_uv || volt->max_uv > INT_MAX)
+		return -ERANGE;
+	cap = volt->max_uv;
+	ids[0] = volt->max0_id;
+	ids[1] = volt->max1_id;
+	ids[2] = volt->max2_id;
+	for (i = 0; i < ARRAY_SIZE(ids); i++) {
+		if (ids[i] != 0xff) {
+			int mapped = nvkm_volt_map(volt, ids[i], temp);
+
+			if (mapped <= 0)
+				return mapped ? mapped : -ERANGE;
+			cap = min(cap, mapped);
+		}
+	}
+	*limit_uv = cap;
+	if (target > cap || (current_known && *current_uv > cap))
+		return -ERANGE;
+	if (current_known && *current_uv >= target)
+		return target;
+	/* Check the voltage this backend can actually produce before changing it. */
+	if (volt->func->volt_roundup) {
+		target = volt->func->volt_roundup(volt, target);
+		if (target <= 0)
+			return target ? target : -ERANGE;
+		if (target > cap)
+			return -ERANGE;
+	}
+	/* PWM backends expose a continuous voltage range instead of VID entries. */
+	if (volt->func->volt_set)
+		return target;
+	for (i = 0; i < volt->vid_nr; i++) {
+		if (volt->vid[i].uv >= (u32)target && volt->vid[i].uv <= (u32)cap)
+			return target;
+	}
+	return -ERANGE;
+}
