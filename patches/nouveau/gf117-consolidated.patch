+	if (!out || !freq)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	out->requested_khz = freq;
+
+	/* Inspect both table layouts without constructing or executing RAMFUC.
+	 * Parsing 0x11 does not make the legacy GF100 write sequence valid. */
+	out->failure_stage = "rammap";
+	rammap.data = nvbios_rammapEm(bios, freq / 1000, &ver, &rammap.size,
+				      &cnt, &ramcfg.size, &cfg);
+	out->rammap_ver = ver;
+	if (!rammap.data)
+		return -EINVAL;
+	if (ver != 0x10 && ver != 0x11)
+		return -EOPNOTSUPP;
+	if (rammap.size < (ver == 0x10 ? 0x0e : 0x12))
+		return -EINVAL;
+
+	out->failure_stage = "ramcfg";
+	strap = nvbios_ramcfg_index(subdev);
+	out->ramcfg_strap = strap;
+	if (strap >= cnt || ramcfg.size < (ver == 0x10 ? 0x0e : 0x0a))
+		return -EINVAL;
+	ramcfg.data = rammap.data + rammap.size + (strap * ramcfg.size);
+	/* RAMCFG 0x11 moves the timing index to byte zero. */
+	strap = nvbios_rd08(bios, ramcfg.data + (ver == 0x10 ? 1 : 0));
+	out->timing_index = strap;
+	if (strap != 0xff) {
+		out->failure_stage = "timing";
+		timing.data = nvbios_timingEe(bios, strap, &ver, &timing.size,
+					      &cnt, &len);
+		out->timing_ver = ver;
+		if (!timing.data)
+			return -EINVAL;
+		if (ver != 0x10 && ver != 0x20)
+			return -EOPNOTSUPP;
+		if (timing.size < (ver == 0x10 ? 0x19 : 0x33))
+			return -EINVAL;
+		out->timing_present = true;
