+		break;
+	case 0x132020:
+		sclk = nvkm_clk_read(&clk->base, nv_clk_src_mpllsrcref);
+		break;
+	case 0x137000:
+	case 0x137020:
+	case 0x137040:
+	case 0x1370e0:
